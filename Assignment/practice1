#reverse string in stack

s = input("Enter string: ")

stack = []

for i in s:
    stack.append(i)

rev = ""

while len(stack) > 0:
    rev = rev + stack.pop()

print("Reversed String:", rev)

#reverse it using another stack

stack = [10, 20, 30]

temp = []

while len(stack) > 0:
    temp.append(stack.pop())

stack = temp

print("Reversed Stack:", stack)